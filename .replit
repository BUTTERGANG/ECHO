# Replit configuration for ECHO.
# Autoscale deployment: a stateless Node server serves the Expo web SPA with
# the cross-origin-isolation headers wa-sqlite needs, plus the Claude proxy.

modules = ["nodejs-22"]

# Local dev inside the Repl: build once, then serve.
run = "npm run deploy:local"

[env]
PORT = "3000"
# Persist Claude Code's auth/settings/session history across Repl restarts.
# $HOME (/home/runner) is wiped on every container boot, but the workspace
# disk is not — so point Claude Code's config dir into the workspace.
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.local/share/claude-config"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build:web"]
run = ["sh", "-c", "npm run serve"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 4000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 9500
externalPort = 3002

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run serve"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# Required Deployment Secrets (set in the Replit "Secrets" / deployment env,
# NOT committed, NOT EXPO_PUBLIC_*):
#   ANTHROPIC_API_KEY   - server-side Claude key (never reaches the client)
# Optional:
#   ANTHROPIC_MODEL     - defaults to claude-sonnet-4-6
#   ALLOWED_ORIGIN      - e.g. https://<your-deployment>.replit.app  (locks the proxy)
#   COEP_POLICY         - require-corp (default) | credentialless (if HF model fetch is blocked)
